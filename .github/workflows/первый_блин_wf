name: CI/CD pipeline пробный

on:
  push:
    branches: [main]
  pull_request:
    branches: [main]

jobs:
# SAST
  security_sast:
    name: SAST
    runs-on: ubuntu-latest
    steps:
      - name: checkout репа
        uses: actions/checkout@v4

      - name: ставит петухон
        uses: actions/setup-python@v5
        with:
          python-version: '3.11'

      - name: ставит бандита
        run: pip install bandit

      - name: запуск бандита
        run: bandit -r services/slicer-adapter/ services/order-service/ services/inventory-service/ -ll -ii

  build_i_sca:
    name: билд докера и SCA
    runs-on: ubuntu-latest
    needs: security_sast
    steps:
      - name: rep checkout
        uses: actions/checkout@v4
# CSA
      - name: Build Order Service image
        run: docker build -t order-service:test ./services/order-service

      - name: Build Inventory Service image
        run: docker build -t inventory-service:test ./services/inventory-service

      - name: Build Slicer Adapter image
        run: docker build -t slicer-adapter:test ./services/slicer-adapter
# Trivy
      - name: Trivy
        uses: aquasecurity/trivy-action@master
        with:
          image-ref: 'order-service:test'
          format: 'table'
          # 'CRITICAL' всё положит)
          exit-code: '1'
          ignore-unfixed: true
          severity: 'CRITICAL,HIGH'

# джоба 3
  deploy:
    name: деплой на прод
    runs-on: ubuntu-latest
    needs: build_i_sca

    if: github.ref == 'refs/heads/main'
    steps:
      - name: STUB
        run:
        # НЕЙРОЗАТЫЧКА
          echo "Здесь будет SSH подключение к боевому серверу"
          echo "Стягивание нового кода: git pull origin main"
          echo "SOPS получает ключ из GitHub Secrets и дешифрует файл:"
          echo 'sops --decrypt --input-type dotenv --output-type dotenv infra/sops/secrets.enc.env > .env'
          echo "Перезапуск: docker compose up -d --build"
