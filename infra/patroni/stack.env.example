# Локально скопировать в stack.env (stack.env не коммитить). Использовать перед ручным deploy:
#
#   set -a
#   source stack.env
#   set +a
#   docker stack deploy --with-registry-auth -c stack.yml postgres-ha
#
# Удобнее вызывать из корня репозитория:
#   docker stack deploy --with-registry-auth -c infra/patroni/stack.yml postgres-ha
#
RESTFUL_BACKEND_NET_NAME=restful-slice_backend_net

# Должен совпадать с тем, каким пользователем db_bootstrap логинится в Postgres через HAProxy.
POSTGRES_SUPERUSER=postgres_admin
POSTGRES_SUPERUSER_PASSWORD=
