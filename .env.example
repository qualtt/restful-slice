# ==========================================
# ИНФРАСТРУКТУРА (Базы данных, очереди)
# ==========================================
POSTGRES_USER=admin
POSTGRES_PASSWORD=supersecret
POSTGRES_DB=3d_print_db
POSTGRES_HOST=postgres # имя контейнера в docker-compose
POSTGRES_PORT=5432

# сервисные пользователи для отдельных БД
ORDER_DB_USER=order_admin
ORDER_DB_PASSWORD=order_pass
ORDER_DB_NAME=orders_db
INV_DB_USER=inv_admin
INV_DB_PASSWORD=inv_pass
INV_DB_NAME=inventory_db

# docker-compose использует эти имена
RMQ_USER=guest
RMQ_PASSWORD=guest

# опционально: дубли для приложений
RABBITMQ_USER=guest
RABBITMQ_PASSWORD=guest
RABBITMQ_HOST=rabbitmq
RABBITMQ_PORT=5672

MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin
MINIO_ENDPOINT=minio:9000
MINIO_BUCKET_NAME=3d-models

# порты python-сервисов внутри docker сети
ORDER_PORT=8080
INVENTORY_PORT=8081

# ==========================================
# НАСТРОЙКИ для разработчиков
# ==========================================
# максимальный размер загружаемого STL файла (MB)
MAX_UPLOAD_SIZE_MB=100
# уровень логирования (DEBUG, INFO, WARNING, ERROR)
LOG_LEVEL=DEBUG
