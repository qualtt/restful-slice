              ]
            }
          },
          "response": []
        },
        {
          "name": "Fetch priced order",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Final order fetch returns 200', function () {",
