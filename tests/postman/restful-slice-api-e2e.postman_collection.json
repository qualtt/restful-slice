                  "});",
                  "const body = pm.response.json();",
                  "pm.test('Fetched order matches created order', function () {",
                  "  pm.expect(body.orderId).to.eql(pm.environment.get('orderId'));",
                  "  pm.expect(body.fileId).to.eql(pm.environment.get('fileId'));",
                  "});",
                  "pm.test('Fetched order stays priced', function () {",
                  "  pm.expect(body.status).to.eql('priced');",
                  "  pm.expect(body.slicingResult.weightGrams).to.be.above(0);",
                  "  pm.expect(body.slicingResult.printTimeSeconds).to.be.above(0);",
                  "});"
                ]
              }
            }
          ],
