        {
          "name": "List print profiles",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Inventory profiles request returns 200', function () {",
                  "  pm.response.to.have.status(200);",
                  "});",
                  "const body = pm.response.json();",
                  "pm.test('Profiles payload contains data array', function () {",
                  "  pm.expect(body).to.have.property('data');",
                  "  pm.expect(body.data).to.be.an('array').that.is.not.empty;",
                  "});",
                  "const requestedProfileId = Number(pm.environment.get('profileId'));",
                  "pm.test('Requested profile exists in inventory', function () {",
                  "  pm.expect(body.data.some((profile) => profile.profileId === requestedProfileId)).to.be.true;",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "auth": {
              "type": "noauth"
            },
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/inventory/profiles?page=1&pageSize=20",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "inventory",
                "profiles"
              ],
              "query": [
                {
                  "key": "page",
                  "value": "1"
                },
                {
                  "key": "pageSize",
                  "value": "20"
                }
              ]
            }
          },
          "response": []
        },
        {
          "name": "Upload sample model",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Model upload returns 201', function () {",
                  "  pm.response.to.have.status(201);",
                  "});",
                  "const body = pm.response.json();",
                  "pm.environment.set('fileId', body.fileId);",
                  "pm.environment.set('uploadedFilename', body.filename);",
                  "pm.test('Upload response contains fileId', function () {",
                  "  pm.expect(body.fileId).to.match(/^[0-9a-fA-F-]{36}$/);",
                  "});",
                  "pm.test('Uploaded file name matches fixture', function () {",
                  "  pm.expect(body.filename).to.eql('cube.stl');",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [],
            "body": {
              "mode": "formdata",
              "formdata": [
                {
                  "key": "file",
                  "type": "file",
                  "src": "{{sampleModelPath}}"
                }
              ]
            },
            "url": {
              "raw": "{{baseUrl}}/api/orders/files",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "orders",
                "files"
              ]
            }
          },
          "response": []
        },
        {
          "name": "Create order",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Create order returns 202', function () {",
                  "  pm.response.to.have.status(202);",
                  "});",
                  "const body = pm.response.json();",
                  "pm.environment.set('orderId', body.orderId);",
                  "pm.environment.set('pollAttempt', '0');",
                  "pm.environment.unset('terminalStatus');",
                  "pm.environment.unset('errorMessage');",
                  "pm.test('Order enters slicing pipeline', function () {",
                  "  pm.expect(body.status).to.eql('slicing');",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"fileId\": \"{{fileId}}\",\n  \"profileId\": {{profileId}}\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{baseUrl}}/api/orders",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "orders"
              ]
            }
          },
          "response": []
        },
        {
          "name": "Poll order until priced",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Polling request returns 200', function () {",
                  "  pm.response.to.have.status(200);",
                  "});",
                  "const body = pm.response.json();",
                  "const status = body.status;",
                  "const attempts = Number(pm.environment.get('pollAttempt') || '0') + 1;",
                  "const maxAttempts = Number(pm.environment.get('maxPollAttempts') || '30');",
                  "pm.environment.set('pollAttempt', String(attempts));",
                  "pm.environment.set('lastOrderStatus', status);",
                  "if (status === 'priced') {",
                  "  pm.environment.set('terminalStatus', status);",
                  "  pm.test('Order reaches priced terminal state', function () {",
                  "    pm.expect(body.slicingResult).to.be.an('object');",
                  "    pm.expect(body.slicingResult.weightGrams).to.be.above(0);",
                  "    pm.expect(body.slicingResult.printTimeSeconds).to.be.above(0);",
                  "    pm.expect(body.slicingResult.price.amount).to.match(/^\\d+(\\.\\d{2})$/);",
                  "    pm.expect(body.slicingResult.price.currency).to.eql('RUB');",
                  "  });",
                  "  postman.setNextRequest('Fetch priced order');",
                  "} else if (status === 'failed') {",
                  "  const errorMessage = body.errorMessage || 'Unknown slicing failure';",
                  "  pm.environment.set('terminalStatus', status);",
                  "  pm.environment.set('errorMessage', errorMessage);",
                  "  pm.test('Order should not fail during slicing', function () {",
                  "    pm.expect.fail('Order failed: ' + errorMessage);",
                  "  });",
                  "  postman.setNextRequest(null);",
                  "} else if (attempts < maxAttempts) {",
                  "  postman.setNextRequest(pm.info.requestName);",
                  "} else {",
                  "  pm.test('Order reaches terminal state before timeout', function () {",
                  "    pm.expect.fail(\"Order is still '\" + status + \"' after \" + attempts + \" polling attempts. Increase maxPollAttempts or runner delay.\");",
                  "  });",
                  "  postman.setNextRequest(null);",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "auth": {
              "type": "noauth"
            },
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/orders/{{orderId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
