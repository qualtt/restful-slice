        {
          "name": "Create order for happy path",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Happy path create returns 202', function () {",
                  "  pm.response.to.have.status(202);",
                  "});",
                  "const body = pm.response.json();",
                  "pm.environment.set('happyOrderId', body.orderId);",
                  "pm.environment.set('happyPollAttempt', '0');",
                  "pm.environment.unset('happyTerminalStatus');",
                  "pm.environment.unset('happyErrorMessage');",
                  "pm.test('Happy path order starts in slicing', function () {",
                  "  pm.expect(body.status).to.eql('slicing');",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"fileId\": \"{{happyFileId}}\",\n  \"profileId\": {{profileId}}\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{baseUrl}}/api/orders",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "orders"
              ]
            }
          },
          "response": []
        },
        {
          "name": "Poll order until priced",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Polling request returns 200', function () {",
                  "  pm.response.to.have.status(200);",
                  "});",
                  "const body = pm.response.json();",
                  "const status = body.status;",
                  "const attempts = Number(pm.environment.get('happyPollAttempt') || '0') + 1;",
                  "const maxAttempts = Number(pm.environment.get('maxPollAttempts') || '30');",
                  "pm.environment.set('happyPollAttempt', String(attempts));",
                  "pm.environment.set('happyLastStatus', status);",
                  "if (status === 'priced') {",
                  "  pm.environment.set('happyTerminalStatus', status);",
                  "  pm.execution.setNextRequest('Get priced order');",
                  "} else if (status === 'failed') {",
                  "  const errorMessage = body.errorMessage || 'Unknown slicing failure';",
                  "  pm.environment.set('happyTerminalStatus', status);",
                  "  pm.environment.set('happyErrorMessage', errorMessage);",
                  "  pm.test('Happy path should not fail', function () {",
                  "    pm.expect.fail('Order failed: ' + errorMessage);",
                  "  });",
                  "  pm.execution.setNextRequest(null);",
                  "} else if (attempts < maxAttempts) {",
                  "  pm.execution.setNextRequest(pm.info.requestName);",
                  "} else {",
                  "  pm.test('Order reaches priced before timeout', function () {",
                  "    pm.expect.fail(\"Order is still '\" + status + \"' after \" + attempts + \" polling attempts.\");",
                  "  });",
                  "  pm.execution.setNextRequest(null);",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/orders/{{happyOrderId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "orders",
                "{{happyOrderId}}"
              ]
            }
          },
          "response": []
        },
        {
          "name": "Get priced order",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Priced order fetch returns 200', function () {",
                  "  pm.response.to.have.status(200);",
                  "});",
                  "const body = pm.response.json();",
                  "pm.test('Priced order contains slicingResult', function () {",
                  "  pm.expect(body.orderId).to.eql(pm.environment.get('happyOrderId'));",
                  "  pm.expect(body.status).to.eql('priced');",
                  "  pm.expect(body.slicingResult).to.be.an('object');",
                  "  pm.expect(body.slicingResult.weightGrams).to.be.above(0);",
                  "  pm.expect(body.slicingResult.printTimeSeconds).to.be.above(0);",
                  "  pm.expect(body.slicingResult.price.amount).to.match(/^\\d+(\\.\\d{2})$/);",
                  "  pm.expect(body.slicingResult.price.currency).to.eql('RUB');",
                  "  if (body.slicingResult.gcodeObjectKey) {",
                  "    pm.environment.set('happyGcodeObjectKey', body.slicingResult.gcodeObjectKey);",
                  "  }",
                  "});"
                ]
              }
            }
          ],
          "request": {
