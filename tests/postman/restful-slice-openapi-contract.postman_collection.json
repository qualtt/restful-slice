      "name": "Inventory",
      "item": [
        {
          "name": "List profiles",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('List profiles returns 200', function () {",
                  "  pm.response.to.have.status(200);",
                  "});",
                  "const body = pm.response.json();",
                  "pm.test('Profiles response contains data and meta', function () {",
                  "  pm.expect(body.data).to.be.an('array').that.is.not.empty;",
                  "  pm.expect(body.meta).to.be.an('object');",
                  "  pm.expect(body.meta.page).to.eql(1);",
                  "  pm.expect(body.meta.pageSize).to.eql(20);",
                  "});",
                  "const profile = body.data[0];",
                  "pm.test('Profile shape matches contract', function () {",
                  "  pm.expect(profile).to.have.property('profileId');",
                  "  pm.expect(profile).to.have.property('displayName');",
                  "  pm.expect(profile).to.have.property('printer');",
                  "  pm.expect(profile).to.have.property('material');",
                  "  pm.expect(profile).to.have.property('process');",
                  "  pm.expect(profile).to.have.property('markupPercent');",
                  "  pm.expect(profile).to.have.property('isEnabled');",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/inventory/profiles?page=1&pageSize=20",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "inventory",
                "profiles"
              ],
              "query": [
                {
                  "key": "page",
                  "value": "1"
                },
                {
                  "key": "pageSize",
                  "value": "20"
                }
              ]
            }
          },
          "response": []
        },
