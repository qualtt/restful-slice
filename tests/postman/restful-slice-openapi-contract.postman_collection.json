          "name": "Create order",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Create order returns 202', function () {",
                  "  pm.response.to.have.status(202);",
                  "});",
                  "const body = pm.response.json();",
                  "pm.environment.set('lifecycleOrderId', body.orderId);",
                  "pm.test('Create order returns slicing state', function () {",
                  "  pm.expect(body.orderId).to.match(/^[0-9a-fA-F-]{36}$/);",
                  "  pm.expect(body.fileId).to.eql(pm.environment.get('lifecycleFileId'));",
                  "  pm.expect(body.profileId).to.eql(Number(pm.environment.get('profileId')));",
                  "  pm.expect(body.status).to.eql('slicing');",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"fileId\": \"{{lifecycleFileId}}\",\n  \"profileId\": {{profileId}}\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{baseUrl}}/api/orders",
              "host": [
                "{{baseUrl}}"
