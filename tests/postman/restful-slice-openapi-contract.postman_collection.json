        {
          "name": "Upload valid model",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Upload returns 201', function () {",
                  "  pm.response.to.have.status(201);",
                  "});",
                  "const body = pm.response.json();",
                  "pm.environment.set('uploadFileId', body.fileId);",
                  "pm.test('Upload response contains file metadata', function () {",
                  "  pm.expect(body.fileId).to.match(/^[0-9a-fA-F-]{36}$/);",
                  "  pm.expect(body.filename).to.eql('cube.stl');",
                  "  pm.expect(body.sizeBytes).to.be.above(0);",
                  "  pm.expect(body.uploadedAt).to.be.a('string');",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
